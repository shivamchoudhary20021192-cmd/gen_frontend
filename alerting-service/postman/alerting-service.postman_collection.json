{
  "info": {
    "name": "Alerting Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "alertId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Severity routing",
      "item": [
        {
          "name": "CRITICAL -> NOTIFY",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alerts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"payments-api\",\n  \"type\": \"high_latency\",\n  \"severity\": \"CRITICAL\",\n  \"message\": \"high_latency observed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 + notified', () => { pm.response.to.have.status(201); const d = pm.response.json().data; pm.expect(d.action).to.eql('NOTIFY'); pm.expect(d.notificationStatus).to.eql('SENT'); pm.collectionVariables.set('alertId', d.id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "HIGH -> NOTIFY",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alerts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"orders-api\",\n  \"type\": \"error_rate\",\n  \"severity\": \"HIGH\",\n  \"message\": \"error_rate observed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('NOTIFY', () => pm.expect(pm.response.json().data.action).to.eql('NOTIFY'));"
                ]
              }
            }
          ]
        },
        {
          "name": "MEDIUM -> LOG_ONLY",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alerts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"orders-api\",\n  \"type\": \"retry_spike\",\n  \"severity\": \"MEDIUM\",\n  \"message\": \"retry_spike observed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('LOG_ONLY, no notification', () => { const d = pm.response.json().data; pm.expect(d.action).to.eql('LOG_ONLY'); pm.expect(d.notificationStatus).to.eql('NOT_REQUIRED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "LOW -> SKIP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alerts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"orders-api\",\n  \"type\": \"disk_80\",\n  \"severity\": \"LOW\",\n  \"message\": \"disk_80 observed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('SKIP, no notification', () => { const d = pm.response.json().data; pm.expect(d.action).to.eql('SKIP'); pm.expect(d.notificationStatus).to.eql('NOT_REQUIRED'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Deduplication",
      "item": [
        {
          "name": "Re-send the CRITICAL alert (duplicate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alerts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"payments-api\",\n  \"type\": \"high_latency\",\n  \"severity\": \"CRITICAL\",\n  \"message\": \"high_latency observed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Same source + type + severity inside the dedup window (default 5 min) is collapsed; no second notification."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 + deduplicated', () => { pm.response.to.have.status(200); const b = pm.response.json(); pm.expect(b.deduplicated).to.eql(true); pm.expect(b.data.occurrenceCount).to.be.above(1); pm.expect(b.data.id).to.eql(pm.collectionVariables.get('alertId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Same type with an explicit dedupKey (new alert)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alerts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"payments-api\",\n  \"type\": \"high_latency\",\n  \"severity\": \"CRITICAL\",\n  \"message\": \"high_latency observed\",\n  \"dedupKey\": \"host-42\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "3. Notifier failure handling",
      "item": [
        {
          "name": "Simulate outage (failureRate = 1)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/mock-notifier",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "mock-notifier"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"failureRate\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "HIGH alert during outage -> FAILED, still 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alerts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"db\",\n  \"type\": \"conn_pool\",\n  \"severity\": \"HIGH\",\n  \"message\": \"conn_pool observed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The ingest call succeeds even though the external call failed; the alert is kept with notificationStatus=FAILED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted but notification FAILED after retries', () => { pm.response.to.have.status(201); const d = pm.response.json().data; pm.expect(d.notificationStatus).to.eql('FAILED'); pm.expect(d.notificationAttempts).to.eql(3); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Restore notifier (failureRate = 0)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/mock-notifier",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "mock-notifier"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"failureRate\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Duplicate re-attempts the failed notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alerts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"db\",\n  \"type\": \"conn_pool\",\n  \"severity\": \"HIGH\",\n  \"message\": \"conn_pool observed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('duplicate + now SENT', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.notificationStatus).to.eql('SENT'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Read APIs",
      "item": [
        {
          "name": "List (newest first)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts?limit=10&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alerts"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "List filtered: severity=HIGH",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts?severity=HIGH",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alerts"
              ],
              "query": [
                {
                  "key": "severity",
                  "value": "HIGH"
                }
              ]
            }
          }
        },
        {
          "name": "List filtered: notificationStatus=FAILED",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts?notificationStatus=FAILED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alerts"
              ],
              "query": [
                {
                  "key": "notificationStatus",
                  "value": "FAILED"
                }
              ]
            }
          }
        },
        {
          "name": "Get by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts/{{alertId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alerts",
                "{{alertId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get unknown id -> 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts/does-not-exist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alerts",
                "does-not-exist"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Validation",
      "item": [
        {
          "name": "Invalid body -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "alerts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"severity\": \"SEVERE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 with field errors', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error.details.length).to.be.above(0); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}